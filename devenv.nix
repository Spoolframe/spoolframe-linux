{
  pkgs,
  lib,
  ...
}: let
  # GStreamer plugins the player loads at run time: demuxers and decoders
  # for the common containers and codecs, libav for the rest, and VA-API
  # hardware decoding (in -bad). gtk4paintablesink is not here: the app
  # links it in (gst-plugin-gtk4), so it uses the app's own GTK.
  gstPlugins = with pkgs.gst_all_1; [
    gstreamer
    gst-plugins-base
    gst-plugins-good
    gst-plugins-bad
    gst-plugins-ugly
    gst-libav
  ];
in {
  # Stable Rust from rust-overlay (devenv.yaml). llvm-tools-preview is what
  # cargo-llvm-cov instruments with in ci:test.
  languages.rust = {
    enable = true;
    channel = "stable";
    components = ["rustc" "cargo" "clippy" "rustfmt" "rust-analyzer" "llvm-tools-preview"];
  };

  # nextest's profiles. `ci` keeps going past a failure and writes the
  # JUnit report CI publishes (target/nextest/ci/junit.xml). Generated, not
  # committed (.gitignore).
  files.".config/nextest.toml".text = ''
    # nextest configuration, generated by devenv.nix.
    # https://nexte.st/docs/configuration/

    [profile.default]
    test-threads = "num-cpus"

    [profile.ci]
    test-threads = "num-cpus"
    fail-fast = false
    status-level = "all"

    [profile.ci.junit]
    # Relative to target/nextest/<profile>/
    path = "junit.xml"
    report-name = "tests"
  '';

  # GTK 4 and libadwaita for the UI, GStreamer for the player; pkg-config
  # finds them for the -sys crates. The theme picker needs libadwaita 1.6
  # or newer.
  packages =
    [
      pkgs.cargo-deny
      pkgs.pkg-config
      pkgs.gtk4
      pkgs.libadwaita
      # egl.pc: the video sink's GL path (gst-plugin-gtk4's wayland and
      # x11egl features) links GStreamer's EGL library.
      pkgs.libGL
      # Passkeys (P3-19): libudev finds security keys; the phone flow
      # reaches BlueZ over D-Bus (libdbus) and its tunnel over TLS
      # (OpenSSL, through native-tls).
      pkgs.systemdLibs
      pkgs.dbus
      pkgs.openssl
      # A security key as a portable identity's root (P7-08): libfido2
      # signs CTAP2 over a hash the client chooses.
      pkgs.libfido2
      # The device key and sessions in the Secret Service.
      pkgs.libsecret
      # scripts/gen-licenses.py, the open source license list.
      pkgs.python3
    ]
    ++ gstPlugins;

  # fido-hid-rs generates its Linux bindings with bindgen.
  env.LIBCLANG_PATH = "${pkgs.llvmPackages.libclang.lib}/lib";

  # Nix keeps each plugin set in its own store path; GStreamer finds them
  # only through this list.
  env.GST_PLUGIN_SYSTEM_PATH_1_0 =
    lib.makeSearchPathOutput "lib" "lib/gstreamer-1.0" gstPlugins;

  # cargo deny in full (deny.toml): advisories, bans, licenses (the GPL
  # client's boundary) and sources. Zero warnings is the bar: deny.toml
  # names only crates in the graph.
  tasks."spoolframe-linux:deny" = {
    description = "Check the Linux client's dependencies with cargo deny";
    exec = "cargo deny --locked check";
  };
  # Settings › About › Open source licenses reads a committed list
  # (crates/spoolframe-linux-app/data/licenses.json); it fails here when
  # Cargo.lock or the Flatpak manifest moved without it.
  tasks."spoolframe-linux:licenses-list" = {
    description = "Check the open source license list is current";
    exec = "python3 scripts/gen-licenses.py --check";
  };
  tasks."ci:static".after = ["spoolframe-linux:deny" "spoolframe-linux:licenses-list"];

  # CI's phases: `devenv --profile ci tasks run ci:style ci:static ci:test`
  # (.forgejo/workflows/ci.yaml runs exactly these). The tools they call
  # live in the profile, so a plain `devenv shell` stays lean.
  # Coldsteel's own infrastructure: crates.io through the kellnr proxy on
  # cargo.coldsteel.casa, and kache, the shared compiler cache in the
  # Garage bucket. Not for anyone else's machine: CI extends it, and so does
  # the user's own account on every machine (profiles.user.andoriyu), so a
  # public checkout never touches either. The SDK's own registry
  # (.cargo/config.toml) is not part of this: every build reads it.
  profiles.coldsteel.module = {pkgs, ...}: let
    kacheConfig = (pkgs.formats.toml {}).generate "kache.toml" {
      cache.remote = {
        type = "s3";
        bucket = "kache";
        endpoint = "https://s3.coldsteel.casa";
        region = "garage";
      };
    };
  in {
    packages = [pkgs.kache];
    env = {
      RUSTC_WRAPPER = "kache";
      KACHE_CONFIG = "${kacheConfig}";
    };
    # The mirror is a cargo config file: cargo does not read [source.*]
    # from environment variables (tested). It goes in cargo's home, never
    # the repo, and a home config that already replaces crates.io is left
    # alone. kache's Garage credentials are rendered by vault-agent on hosts
    # and runners; without them kache caches locally only.
    enterShell = ''
      cargo_home="''${CARGO_HOME:-$HOME/.cargo}"
      if ! grep -qs '^\[source.crates-io\]' "$cargo_home/config.toml"; then
        mkdir -p "$cargo_home"
        cat >> "$cargo_home/config.toml" <<'TOML'
      [source.crates-io]
      replace-with = "coldsteel-mirror"

      [source.coldsteel-mirror]
      registry = "sparse+https://cargo.coldsteel.casa/api/v1/cratesio/"
      TOML
      fi
      unset cargo_home
      kache_env="''${KACHE_CREDENTIALS_FILE:-/run/kache/s3.env}"
      if [ -r "$kache_env" ]; then
        set -a
        . "$kache_env"
        set +a
      fi
      unset kache_env
    '';
  };
  profiles.user.andoriyu.extends = ["coldsteel"];

  profiles.ci.extends = ["coldsteel"];
  profiles.ci.module = {pkgs, ...}: {
    # devenv's automatic cachix setup fails under a pure flake eval and an
    # untrusted runner user; substituters are configured on the runner host.
    cachix.enable = lib.mkForce false;

    packages = with pkgs; [
      cargo-nextest
      cargo-llvm-cov
      cargo-audit
    ];

    tasks = {
      "ci:style" = {
        description = "Check formatting with rustfmt";
        exec = "cargo fmt --all -- --check";
      };
      "ci:static" = {
        description = "Clippy over every target, warnings denied";
        exec = "cargo clippy --locked --workspace --all-targets -- -D warnings";
      };
      # JUnit (nextest's ci profile) at target/nextest/ci/junit.xml and lcov
      # at target/lcov.info; the workflow publishes both. Tests that need a
      # display, GStreamer's plugins or a live server are #[ignore]d.
      # Registry sources are left out by any path: kache remaps cargo's home
      # to /kache/.cargo, which llvm-cov's own filter (the real home) misses,
      # and genhtml then fails on macro code from crates it cannot find.
      # vendor/ (the patched webauthn crates) is left out the same way: it
      # is upstream's code, not the client's.
      "ci:test" = {
        description = "Tests with nextest under llvm-cov (JUnit + lcov)";
        exec = "cargo llvm-cov nextest --locked --workspace --profile ci --no-tests=warn --ignore-filename-regex '/\\.cargo/(registry|git)/|/vendor/' --lcov --output-path target/lcov.info";
      };
      # Daily, in .forgejo/workflows/audit.yaml. cargo audit reads
      # .cargo/audit.toml: deny.toml's accepted advisories, and warnings
      # (unmaintained, yanked) fail it. One Cargo.lock, at the root.
      "ci:audit" = {
        description = "Audit dependencies for known vulnerabilities";
        exec = "cargo audit";
      };
    };
  };

  enterShell = ''
    echo "spoolframe-linux dev environment"
  '';
}
